/* systop dashboard uslublari — sovuq "terminal" palitrasi (systop temasi) */

/* TRANSPARENT background — the app inherits the terminal's own background
   so it blends into its surroundings. */
Screen {
    layout: vertical;
    background: transparent;
}

Header, Footer {
    background: transparent;
}

/* --- Holat-paneli (Header ostidagi chiplar qatori) --- */

#status-bar {
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $foreground;
}

/* Chips: auto width, not 1fr — they group tightly to the left instead of
   spreading out.
   Each one gets its own background and right margin so it reads as a real
   "chip". */
#status-bar > Static {
    width: auto;
    height: 1;
    content-align: left middle;
    background: $panel;
    margin-right: 1;
    padding: 0 2;
}

#chip-gateway {
    color: $secondary;
}
#chip-public {
    color: $accent;
}
#chip-iface {
    color: $success;
}

/* --- Main layout: left column (speed+ping) | right column (topology) ---
   Both columns are 1fr wide and fill the available height (full-screen). */

#main {
    layout: horizontal;
    height: 1fr;
    padding: 1;
}

/* Chap ustun: tezlik (tepa) + ping (past), ikkalasi teng balandlikda. */
#left-col {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}

/* The speed panel sizes to its content (auto) so it does not sit ~70% empty
   while idle; the freed height goes to the ping panel (1fr). */
#speed {
    height: auto;
    margin-bottom: 1;
}
#ping {
    height: 1fr;
}

/* Right column: topology — full height. */
#topology {
    width: 1fr;
    height: 1fr;
}

SpeedPanel, PingPanel, TopologyPanel {
    border: round $primary 60%;
    border-title-color: $primary;
    border-title-style: bold;
    /* Key hint to the right of the panel title (border_subtitle), e.g. "s start". */
    border-subtitle-color: $secondary;
    border-subtitle-align: right;
    background: transparent;
    padding: 0 1;
    min-height: 8;
}

/* On focus the border switches to the accent colour. */
SpeedPanel:focus-within, PingPanel:focus-within, TopologyPanel:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

/* --- ASCII degrade mode (legacy Windows console, no Unicode) ---
   The `Screen.-ascii` class is added in `app.py` when unicode_ok() is False.
   The round border is made of Unicode box characters, which in a legacy
   would be mojibake. So we fall back to ASCII borders (+- |) and hide the
   the sparklines are hidden (the numeric caption still shows the values). */

.-ascii SpeedPanel, .-ascii PingPanel, .-ascii TopologyPanel {
    border: ascii $primary 60%;
}
.-ascii SpeedPanel:focus-within,
.-ascii PingPanel:focus-within,
.-ascii TopologyPanel:focus-within {
    border: ascii $accent;
}
.-ascii #help-box {
    border: ascii $accent;
}
.-ascii #help-title {
    border-bottom: ascii $primary 40%;
}
/* The sparkline block glyphs (▁▂▃▅▆▇) do not exist in legacy codepages,
   so they are hidden there.
   What remains is the current/min/avg/max caption under the chart. */
.-ascii Sparkline {
    display: none;
}

/* --- Tezlik paneli --- */

#speed-readout {
    height: auto;
    padding: 1 0 0 0;
}

#speed-loading {
    height: 1;
    color: $secondary;
}

/* --- Sparkline grafiklar va ularning izohi --- */

Sparkline {
    height: 3;
    margin: 1 0 0 0;
}

.spark-caption {
    height: 1;
    color: $foreground 70%;
    padding: 0;
    margin: 0 0 1 0;
}

#speed-spark > .sparkline--max-color {
    color: $success;
}
#speed-spark > .sparkline--min-color {
    color: $success 35%;
}
#ping-spark > .sparkline--max-color {
    color: $secondary;
}
#ping-spark > .sparkline--min-color {
    color: $secondary 35%;
}

/* --- Jadvallar --- */

DataTable {
    height: 1fr;
    min-height: 4;
    background: transparent;
}

DataTable > .datatable--header {
    background: $panel;
    color: $secondary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent 25%;
}

/* The ping table sizes to its content (auto) so the chart sits directly under
   it (1fr would stretch and push the chart to the bottom of the panel). */
#ping-table {
    height: auto;
    max-height: 14;
}

/* --- Tugmalar --- */

Button {
    margin: 0;
    min-width: 16;
}

/* The button is compact, not full width — it is a secondary affordance
   (the `s` key does the same thing). */
#run-speed {
    margin: 1 0 0 0;
    width: auto;
}

/* --- Topologiya tablari va boshqaruvlari --- */

TabbedContent {
    height: 1fr;
}

#lan-controls, #trace-controls, #bw-controls, #conn-controls {
    height: auto;
    padding: 1 0 0 0;
    align: left middle;
}

#scan-lan {
    margin: 0 1 0 0;
}

#trace-target {
    width: 2fr;
}

#trace-live {
    width: auto;
    margin: 0 1;
    background: transparent;
}

#run-trace {
    width: auto;
    margin: 0 1;
}

#run-bw, #run-conn {
    margin: 0 1 0 0;
}

#lan-loading, #trace-loading, #bw-loading, #conn-loading {
    width: auto;
    height: 1;
    color: $secondary;
    content-align: left middle;
}

/* --- Empty / error states (placeholder) --- */

/* Empty state centred in the panel (1fr fills, the text centres):
   glyph qatori + sarlavha + "nima kutiladi" izohi + inline tugma. */
.empty-state {
    height: 1fr;
    padding: 2 1;
    color: $foreground 70%;
    content-align: center middle;
    text-align: center;
}

/* --- Yordam modali --- */

HelpScreen {
    align: center middle;
    background: $background 60%;
}

#help-wrap {
    width: auto;
    height: auto;
}

#help-box {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#help-title {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    padding: 0 0 1 0;
    border-bottom: solid $primary 40%;
}

#help-body {
    width: 100%;
    padding: 1 0 0 0;
}
